; Project configuration for Chronoflora
; Godot 4.x project settings

config/application = {
    "name": "Chronoflora",
}

display/window = {
    "size": [1280, 720],
    "title": "Chronoflora - Vertical Slice",
    "resizable": true,
    "vsync": "enabled",
}

display/antisaliasing = {
    "quality": "msaa_disabled",
}

rendering/qualitys = {
    "driver": "opengl3",
    "use_2d_pixel_snap": true,
}

rendering/2d = {
    "snap_sprites_to_pixels": true,
}

input/mouse_emulate_touch = false
input/touch_emulate_mouse = true

filesystem = {
    "default_script_template": "res://scripts/templates/default.gd.tpl",
}

languages = {
    "default_locale": "en",
}

debug/settings = {
    "live_edit/enabled": true,
    "live_edit/port": 6008,
}

audio/driver = "dummy"

application/run/main_scene = "res://scenes/Main.tscn"

[input]

ui_up = {
    "deadzone": 0.5,
    "events": [Object(InputEventKey,"device":-1,"key":38,"pressed":true,"echo":false,"script":null), Object(InputEventKey,"device":-1,"key":119,"pressed":true,"echo":false,"script":null)]
}
ui_down = {
    "deadzone": 0.5,
    "events": [Object(InputEventKey,"device":-1,"key":40,"pressed":true,"echo":false,"script":null), Object(InputEventKey,"device":-1,"key":115,"pressed":true,"echo":false,"script":null)]
}
